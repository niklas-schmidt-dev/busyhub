{
  "name": "busyhub",
  "productName": "BusyHub",
  "private": true,
  "version": "0.2.2",
  "description": "A desktop marketplace for BUSY Bar apps. Run every app on the bar or from your computer.",
  "license": "MIT",
  "author": "Niklas Schmidt (https://github.com/niklas-schmidt-dev)",
  "homepage": "https://github.com/niklas-schmidt-dev/busyhub",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niklas-schmidt-dev/busyhub.git"
  },
  "bugs": {
    "url": "https://github.com/niklas-schmidt-dev/busyhub/issues"
  },
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "apps:check": "node scripts/check-apps.ts",
    "apps:readme": "node scripts/apps-readme.ts",
    "dist": "pnpm build && pnpm catalog:build && electron-builder --publish never",
    "catalog:build": "node scripts/build-catalog.ts"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@busy-app/busy-lib": "0.21.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "electron-vite": "6.0.0",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
